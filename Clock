/* =========================================================
   CALENDÁRIO 14 MESES
   =========================================================

   ESTRUTURA:

   Meses 1–13:
   3 semanas × 9 dias
   = 27 dias por mês

   Mês 14:
   2 semanas × 7 dias
   = 14 dias

   Total:

   13 × 27 = 351
   351 + 14 = 365 dias

   Ano bissexto:

   365 + 1 dia especial = 366

   O dia bissexto não pertence a nenhuma
   das semanas do calendário.

========================================================= */


/* =========================================================
   CONFIGURAÇÕES
========================================================= */

const TOTAL_MESES = 14;


/*
   Quantidade de meses regulares.
*/

const MESES_REGULARES = 13;


/*
   Meses 1–13:

   3 semanas
   ×
   9 dias

   = 27 dias
*/

const SEMANAS_MES_REGULAR = 3;

const DIAS_POR_SEMANA_REGULAR = 9;

const DIAS_POR_MES =
    SEMANAS_MES_REGULAR *
    DIAS_POR_SEMANA_REGULAR;


/*
   Total dos primeiros 13 meses.

   13 × 27 = 351
*/

const DIAS_REGULARES =
    MESES_REGULARES *
    DIAS_POR_MES;


/*
   Mês 14:

   2 semanas
   ×
   7 dias

   = 14 dias
*/

const SEMANAS_MES_FINAL = 2;

const DIAS_POR_SEMANA_FINAL = 7;

const DIAS_MES_FINAL =
    SEMANAS_MES_FINAL *
    DIAS_POR_SEMANA_FINAL;


/*
   Dia especial do ano bissexto.
*/

const DIA_BISSEXTO = 1;


/* =========================================================
   ESTADO
========================================================= */

let anoAtual = 2026;

let mesAtual = 1;


/* =========================================================
   NOMES DOS MESES
========================================================= */

const nomesMeses = [

    "Uno",
    "Duo",
    "Tri",
    "Quadra",
    "Quinta",
    "Sexto",
    "Sevei",
    "Octo",
    "Nono",
    "Dez",
    "Unz",
    "Doz",
    "Trez",
    "Cato"

];


/* =========================================================
   ELEMENTOS
========================================================= */

const daysContainer =
    document.getElementById("days");


const monthName =
    document.getElementById("monthName");


const yearDisplay =
    document.getElementById("yearDisplay");


const selectedDate =
    document.getElementById("selectedDate");


const gregorianDate =
    document.getElementById("gregorianDate");


const dayOfYear =
    document.getElementById("dayOfYear");


const extraDays =
    document.getElementById("extraDays");


/*
   Elementos do centro.
*/

const centerMonth =
    document.getElementById("centerMonth");


const centerYear =
    document.getElementById("centerYear");


/* =========================================================
   ANO BISSEXTO
========================================================= */

function ehBissexto(ano) {

    return (

        ano % 400 === 0 ||

        (
            ano % 4 === 0 &&
            ano % 100 !== 0
        )

    );

}


/* =========================================================
   DIAS DO ANO
========================================================= */

function quantidadeDiasNoAno(ano) {

    if (ehBissexto(ano)) {

        return 366;

    }

    return 365;

}


/* =========================================================
   DIAS DO MÊS
========================================================= */

function quantidadeDiasMes(
    mes,
    ano
) {

    /*
       Meses 1–13:

       3 semanas × 9 dias
       = 27 dias.
    */

    if (
        mes <=
        MESES_REGULARES
    ) {

        return DIAS_POR_MES;

    }


    /*
       Mês 14:

       2 semanas × 7 dias
       = 14 dias.

       O dia bissexto fica fora
       da estrutura normal.
    */

    return DIAS_MES_FINAL;

}


/* =========================================================
   DIAS DA SEMANA DO MÊS
========================================================= */

function quantidadeDiasPorSemana(
    mes
) {

    /*
       Meses 1–13:

       semana de 9 dias.
    */

    if (
        mes <=
        MESES_REGULARES
    ) {

        return DIAS_POR_SEMANA_REGULAR;

    }


    /*
       Mês 14:

       semana de 7 dias.
    */

    return DIAS_POR_SEMANA_FINAL;

}


/* =========================================================
   QUANTIDADE DE SEMANAS DO MÊS
========================================================= */

function quantidadeSemanasMes(
    mes
) {

    if (
        mes <=
        MESES_REGULARES
    ) {

        return SEMANAS_MES_REGULAR;

    }


    return SEMANAS_MES_FINAL;

}


/* =========================================================
   OBTER SEMANA DO MÊS
========================================================= */

function obterSemanaDoMes(
    mes,
    dia
) {

    const diasPorSemana =
        quantidadeDiasPorSemana(
            mes
        );


    return Math.floor(

        (
            dia - 1
        )

        /

        diasPorSemana

    ) + 1;

}


/* =========================================================
   OBTER DIA DA SEMANA
========================================================= */

function obterDiaDaSemana(
    mes,
    dia
) {

    const diasPorSemana =
        quantidadeDiasPorSemana(
            mes
        );


    return (

        (
            dia - 1
        )

        %

        diasPorSemana

    ) + 1;

}


/* =========================================================
   REDUÇÃO NUMEROLÓGICA
========================================================= */

function reduzirNumero(
    numero
) {

    while (
        numero >= 10
    ) {

        numero =
            String(numero)
                .split("")
                .reduce(

                    function (
                        soma,
                        digito
                    ) {

                        return soma +
                            Number(digito);

                    },

                    0

                );

    }


    return numero;

}


/* =========================================================
   CALENDÁRIO → GREGORIANO
========================================================= */

function obterDataGregoriana(
    ano,
    mes,
    dia
) {

    /*
       Número do dia dentro
       do ano.

       Meses 1–13:
       27 dias cada.

       Mês 14:
       14 dias.
    */

    let numeroDoDia = 0;


    /*
       Meses 1–13.
    */

    if (
        mes <=
        MESES_REGULARES
    ) {

        numeroDoDia =

            (
                (
                    mes - 1
                )

                *

                DIAS_POR_MES

            )

            +

            dia;

    }

    else {

        /*
           Mês 14.
        */

        numeroDoDia =

            DIAS_REGULARES +
            dia;

    }


    /*
       Converter para Gregorian.

       O Date aceita:

       new Date(ano, 0, 1)

       = 1º de janeiro.

       Por isso utilizamos
       numeroDoDia - 1.
    */

    const data =
        new Date(
            ano,
            0,
            numeroDoDia
        );


    return data;

}


/* =========================================================
   FORMATAR DATA
========================================================= */

function formatarData(
    data
) {

    return data.toLocaleDateString(

        "pt-BR",

        {

            weekday: "long",

            day: "2-digit",

            month: "2-digit",

            year: "numeric"

        }

    );

}


/* =========================================================
   VERIFICAR SE É HOJE
========================================================= */

function ehHoje(
    data
) {

    const hoje =
        new Date();


    return (

        data.getFullYear() ===
        hoje.getFullYear()

        &&

        data.getMonth() ===
        hoje.getMonth()

        &&

        data.getDate() ===
        hoje.getDate()

    );

}


/* =========================================================
   CRIAR UM DIA
========================================================= */

function criarDia(
    ano,
    mes,
    dia
) {

    const elemento =
        document.createElement(
            "div"
        );


    elemento.classList.add(
        "day"
    );


    /*
       Número do dia.
    */

    const numero =
        document.createElement(
            "div"
        );


    numero.classList.add(
        "day-number"
    );


    /*
       Número original +
       número reduzido.
    */

    numero.innerHTML = `

        <span class="numero-original">
            ${dia}
        </span>

        <span class="numero-reduzido">
            ${reduzirNumero(dia)}
        </span>

    `;


    /*
       Data gregoriana.
    */

    const data =
        obterDataGregoriana(

            ano,
            mes,
            dia

        );


    const gregoriano =
        document.createElement(
            "div"
        );


    gregoriano.classList.add(
        "day-gregorian"
    );


    gregoriano.textContent =

        data.toLocaleDateString(
            "pt-BR"
        );


    /*
       Semana.
    */

    const semana =
        obterSemanaDoMes(
            mes,
            dia
        );


    /*
       Dia dentro da semana.
    */

    const diaSemana =
        obterDiaDaSemana(
            mes,
            dia
        );


    /*
       Guardar essas informações
       no elemento.

       Isso também pode ser usado
       pelo CSS futuramente.
    */

    elemento.dataset.semana =
        semana;


    elemento.dataset.diaSemana =
        diaSemana;


    /*
       Adicionar elementos.
    */

    elemento.appendChild(
        numero
    );


    elemento.appendChild(
        gregoriano
    );


    /*
       Verificar hoje.
    */

    if (
        ehHoje(data)
    ) {

        elemento.classList.add(
            "today"
        );

    }


    /*
       Clique.
    */

    elemento.addEventListener(

        "click",

        function () {

            selecionarDia(

                ano,
                mes,
                dia,
                data,
                elemento

            );

        }

    );


    return elemento;

}


/* =========================================================
   POSICIONAR OS DIAS EM CÍRCULO
========================================================= */

function posicionarDiasCirculares() {

    const elementos =
        daysContainer.querySelectorAll(
            ".day"
        );


    const total =
        elementos.length;


    if (!total) {

        return;

    }


    /*
       Tamanho real do calendário.
    */

    const largura =
        daysContainer.clientWidth;


    const altura =
        daysContainer.clientHeight;


    /*
       Raio.
    */

    const raio =
        Math.min(
            largura,
            altura
        ) * 0.40;


    /*
       Posicionar cada dia.
    */

    elementos.forEach(

        function (
            elemento,
            indice
        ) {

            /*
               Distribuição circular.

               O primeiro dia começa
               no topo.
            */

            const angulo =

                (
                    indice /
                    total
                )

                *

                Math.PI *
                2

                -

                Math.PI / 2;


            /*
               X.
            */

            const x =

                Math.cos(
                    angulo
                )

                *

                raio;


            /*
               Y.
            */

            const y =

                Math.sin(
                    angulo
                )

                *

                raio;


            /*
               Posicionar.
            */

            elemento.style.transform =

                `translate(${x}px, ${y}px)`;

        }

    );

}


/* =========================================================
   ATUALIZAR SEMANAS DO MÊS
========================================================= */

function atualizarDiasDaSemana() {

    const weekdays =
        document.querySelector(
            ".weekdays"
        );


    if (!weekdays) {

        return;

    }


    /*
       Limpar o círculo interno.
    */

    weekdays.innerHTML = "";


    /*
       Meses 1–13:

       3 semanas.

       Mês 14:

       2 semanas.
    */

    const quantidadeSemanas =
        quantidadeSemanasMes(
            mesAtual
        );


    /*
       Criar somente as semanas.

       NÃO criamos os 9 dias aqui.
    */

    for (

        let semana = 1;

        semana <= quantidadeSemanas;

        semana++

    ) {

        const elemento =
            document.createElement(
                "div"
            );


        elemento.classList.add(
            "weekday"
        );


        /*
           Mostrar:

           1
           2
           3
        */

        elemento.textContent =
            semana;


        /*
           Guardar o número
           da semana.
        */

        elemento.dataset.semana =
            semana;


        weekdays.appendChild(
            elemento
        );

    }


    /*
       Posicionar as semanas
       no círculo interno.
    */

    posicionarDiasDaSemana();

}


/* =========================================================
   POSICIONAR AS SEMANAS EM CÍRCULO
========================================================= */

function posicionarDiasDaSemana() {

    const elementos =
        document.querySelectorAll(
            ".weekdays div"
        );


    const total =
        elementos.length;


    if (!total) {

        return;

    }


    /*
       Tamanho do calendário.
    */

    const largura =
        daysContainer.clientWidth;


    const altura =
        daysContainer.clientHeight;


    /*
       Raio do círculo interno.

       Ele fica mais próximo
       do centro.
    */

    const raio =
        Math.min(
            largura,
            altura
        ) * 0.25;


    /*
       Posicionar as semanas.
    */

    elementos.forEach(

        function (
            elemento,
            indice
        ) {

            const angulo =

                (
                    indice /
                    total
                )

                *

                Math.PI *
                2

                -

                Math.PI / 2;


            const x =

                Math.cos(
                    angulo
                )

                *

                raio;


            const y =

                Math.sin(
                    angulo
                )

                *

                raio;


            elemento.style.transform =

                `translate(-50%, -50%) translate(${x}px, ${y}px)`;

        }

    );

}


/* =========================================================
   POSICIONAR CALENDÁRIO CIRCULAR
========================================================= */

function posicionarCalendarioCircular() {

    posicionarDiasCirculares();

    posicionarDiasDaSemana();

}


/* =========================================================
   REDIMENSIONAMENTO
========================================================= */

window.addEventListener(

    "resize",

    function () {

        posicionarCalendarioCircular();

    }

);


/* =========================================================
   RENDERIZAR OS DIAS DO MÊS
========================================================= */

function renderizarDias() {

    /*
       Limpar.
    */

    daysContainer.innerHTML = "";


    /*
       Quantidade de dias.
    */

    const quantidadeDias =

        quantidadeDiasMes(

            mesAtual,
            anoAtual

        );


    /*
       Criar.
    */

    for (

        let dia = 1;

        dia <= quantidadeDias;

        dia++

    ) {

        const elemento =

            criarDia(

                anoAtual,
                mesAtual,
                dia

            );


        daysContainer.appendChild(
            elemento
        );

    }


    /*
       Esperar o navegador
       calcular dimensões.
    */

    requestAnimationFrame(

        function () {

            posicionarCalendarioCircular();

        }

    );

}


/* =========================================================
   RENDERIZAR CALENDÁRIO COMPLETO
========================================================= */

function renderizarCalendario() {

    /*
       Nome do mês.
    */

    monthName.textContent =

        nomesMeses[
            mesAtual - 1
        ];


    /*
       Ano.
    */

    yearDisplay.textContent =
        anoAtual;


    /*
       Centro.
    */

    if (centerMonth) {

        centerMonth.textContent =

            nomesMeses[
                mesAtual - 1
            ];

    }


    if (centerYear) {

        centerYear.textContent =
            anoAtual;

    }


    /*
       Atualizar semanas.

       9 para meses 1–13.

       7 para mês 14.
    */

    atualizarDiasDaSemana();


    /*
       Criar dias.
    */

    renderizarDias();


    /*
       Área de dias extras.
    */

    renderizarDiasExtras();

}


/* =========================================================
   SELECIONAR DIA
========================================================= */

function selecionarDia(

    ano,
    mes,
    dia,
    data,
    elemento

) {

    /*
       Remover seleção anterior.
    */

    document
        .querySelectorAll(
            ".day"
        )
        .forEach(

            function (
                diaElemento
            ) {

                diaElemento.classList.remove(
                    "selected"
                );

            }

        );


    /*
       Selecionar.
    */

    elemento.classList.add(
        "selected"
    );


    /*
       Número reduzido.
    */

    const numeroReduzido =
        reduzirNumero(dia);


    /*
       Semana.
    */

    const semana =
        obterSemanaDoMes(
            mes,
            dia
        );


    /*
       Dia da semana.
    */

    const diaSemana =
        obterDiaDaSemana(
            mes,
            dia
        );


    /*
       Informações.
    */

    selectedDate.textContent =

        `${nomesMeses[mes - 1]} — Dia ${dia} → ${numeroReduzido}`;


    /*
       Data gregoriana.
    */

    gregorianDate.textContent =

        `Data gregoriana: ${formatarData(data)}`;


    /*
       Semana.
    */

    const informacaoSemana =

        `Semana ${semana} — Dia ${diaSemana}`;


    /*
       Número do dia no ano.
    */

    const numeroDoDia =

        obterNumeroDoDia(
            mes,
            dia
        );


    /*
       Dia do ano.
    */

    dayOfYear.textContent =

        `${informacaoSemana} — Dia ${numeroDoDia} de ${quantidadeDiasNoAno(ano)}`;

}


/* =========================================================
   OBTER NÚMERO DO DIA NO ANO
========================================================= */

function obterNumeroDoDia(

    mes,
    dia

) {

    /*
       Meses 1–13.
    */

    if (
        mes <=
        MESES_REGULARES
    ) {

        return (

            (
                mes - 1
            )

            *

            DIAS_POR_MES

        )

        +

        dia;

    }


    /*
       Mês 14.
    */

    return (

        DIAS_REGULARES +

        dia

    );

}


/* =========================================================
   CONVERTER DIA DO ANO → MÊS
========================================================= */

function obterMesDoCalendario(
    numeroDoDia
) {

    /*
       Primeiros 351 dias.
    */

    if (
        numeroDoDia <=
        DIAS_REGULARES
    ) {

        return Math.floor(

            (
                numeroDoDia - 1
            )

            /

            DIAS_POR_MES

        ) + 1;

    }


    /*
       Últimos 14 dias.
    */

    return TOTAL_MESES;

}


/* =========================================================
   CONVERTER DIA DO ANO → DIA DO MÊS
========================================================= */

function obterDiaDoMes(
    numeroDoDia,
    mes
) {

    /*
       Meses 1–13.
    */

    if (
        mes <=
        MESES_REGULARES
    ) {

        return (

            (
                numeroDoDia - 1
            )

            %

            DIAS_POR_MES

        )

        +

        1;

    }


    /*
       Mês 14.
    */

    return (

        numeroDoDia -
        DIAS_REGULARES

    );

}


/* =========================================================
   DIAS EXTRAS
========================================================= */

function renderizarDiasExtras() {

    if (!extraDays) {

        return;

    }


    /*
       Limpar área antiga.
    */

    extraDays.innerHTML = "";


    /*
       Ano bissexto.

       Criamos um dia especial separado.

       Ele não pertence a uma semana.
    */

    if (
        ehBissexto(anoAtual)
    ) {

        const elemento =
            document.createElement(
                "div"
            );


        elemento.classList.add(
            "dia-bissexto"
        );


        elemento.textContent =
            "Dia Bissexto";


        extraDays.appendChild(
            elemento
        );

    }

}


/* =========================================================
   MUDAR MÊS
========================================================= */

function mudarMes(
    valor
) {

    mesAtual += valor;


    /*
       Avançou além do mês 14.
    */

    if (
        mesAtual >
        TOTAL_MESES
    ) {

        mesAtual = 1;

        anoAtual++;

    }


    /*
       Voltou antes do mês 1.
    */

    if (
        mesAtual < 1
    ) {

        mesAtual =
            TOTAL_MESES;

        anoAtual--;

    }


    renderizarCalendario();

}


/* =========================================================
   MUDAR ANO
========================================================= */

function mudarAno(
    valor
) {

    anoAtual += valor;

    renderizarCalendario();

}


/* =========================================================
   IR PARA HOJE
========================================================= */

function irParaHoje() {

    const hoje =
        new Date();


    /*
       Ano atual.
    */

    anoAtual =
        hoje.getFullYear();


    /*
       Início do ano.
    */

    const inicioDoAno =
        new Date(

            anoAtual,
            0,
            1

        );


    /*
       Diferença em dias.
    */

    const diferenca =

        Math.floor(

            (
                hoje -
                inicioDoAno
            )

            /

            (
                1000 *
                60 *
                60 *
                24
            )

        );


    /*
       Número do dia.

       1 = 1º de janeiro.
    */

    const numeroDoDia =
        diferenca + 1;


    /*
       Verificar se estamos
       no dia bissexto especial.

       Em um ano bissexto,
       o dia 366 é separado.
    */

    if (
        ehBissexto(anoAtual)

        &&

        numeroDoDia === 366
    ) {

        /*
           Não existe um mês normal
           para esse dia.

           Mantemos o mês 14
           visualmente selecionado.
        */

        mesAtual =
            TOTAL_MESES;


        renderizarCalendario();


        if (extraDays) {

            const elemento =
                extraDays.querySelector(
                    ".dia-bissexto"
                );


            if (elemento) {

                elemento.classList.add(
                    "selected"
                );

            }

        }


        return;

    }


    /*
       Descobrir o mês.
    */

    mesAtual =
        obterMesDoCalendario(
            numeroDoDia
        );


    /*
       Descobrir o dia.
    */

    const dia =
        obterDiaDoMes(

            numeroDoDia,
            mesAtual

        );


    /*
       Renderizar.
    */

    renderizarCalendario();


    /*
       Localizar elementos.
    */

    const elementos =
        document.querySelectorAll(
            ".day"
        );


    /*
       Índice começa em zero.
    */

    const indice =
        dia - 1;


    if (
        elementos[indice]
    ) {

        const data =

            obterDataGregoriana(

                anoAtual,
                mesAtual,
                dia

            );


        selecionarDia(

            anoAtual,
            mesAtual,
            dia,
            data,
            elementos[indice]

        );

    }

}


