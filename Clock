/* =========================================================
   CALENDÁRIO 14 MESES — 13 × 27 + 14º MÊS
   =========================================================

   13 meses de 27 dias
   14º mês de 14 dias
   14º mês de 15 dias em ano bissexto

   365 dias em ano comum
   366 dias em ano bissexto

   ========================================================= */


/* =========================================================
   CONFIGURAÇÕES
========================================================= */

const TOTAL_MESES = 14;

const MESES_REGULARES = 13;

const DIAS_POR_MES = 27;

const DIAS_REGULARES =
    MESES_REGULARES * DIAS_POR_MES;

const DIAS_MES_FINAL = 14;


/* =========================================================
   ESTADO
========================================================= */

let anoAtual = 2026;

let mesAtual = 1;


/* =========================================================
   NOMES DOS MESES
========================================================= */

const nomesMeses = [

    "Uno",
    "Dat",
    "Triv",
    "Quadro",
    "Quinta",
    "Sexto",
    "Sevei",
    "Octo",
    "Nono",
    "Dez",
    "Onze",
    "Doze",
    "Treze",
    "Catorze"

];


/* =========================================================
   ELEMENTOS
========================================================= */

const daysContainer =
    document.getElementById("days");

const monthName =
    document.getElementById("monthName");

const yearDisplay =
    document.getElementById("yearDisplay");

const selectedDate =
    document.getElementById("selectedDate");

const gregorianDate =
    document.getElementById("gregorianDate");

const dayOfYear =
    document.getElementById("dayOfYear");

const extraDays =
    document.getElementById("extraDays");


/*
   Elementos do centro do calendário.
*/

const centerMonth =
    document.getElementById("centerMonth");

const centerYear =
    document.getElementById("centerYear");


/* =========================================================
   ANO BISSEXTO
========================================================= */

function ehBissexto(ano) {

    return (

        ano % 400 === 0 ||

        (
            ano % 4 === 0 &&
            ano % 100 !== 0
        )

    );

}


/* =========================================================
   DIAS DO ANO
========================================================= */

function quantidadeDiasNoAno(ano) {

    if (ehBissexto(ano)) {

        return 366;

    }

    return 365;

}


/* =========================================================
   DIAS DO 14º MÊS
========================================================= */

function quantidadeDiasMes(mes, ano) {

    /*
       Os primeiros 13 meses possuem 27 dias.

       O 14º mês possui:
       - 14 dias em ano comum
       - 15 dias em ano bissexto
    */

    if (mes === TOTAL_MESES) {

        return ehBissexto(ano)
            ? 15
            : 14;

    }

    return DIAS_POR_MES;

}


/* =========================================================
   REDUÇÃO NUMEROLÓGICA
=========================================================

   Exemplos:

   1  → 1
   2  → 2
   ...
   9  → 9

   10 → 1 + 0 = 1
   11 → 1 + 1 = 2
   12 → 1 + 2 = 3
   13 → 1 + 3 = 4

   27 → 2 + 7 = 9

========================================================= */

function reduzirNumero(numero) {

    while (numero >= 10) {

        numero = String(numero)
            .split("")
            .reduce(

                function (soma, digito) {

                    return soma +
                        Number(digito);

                },

                0

            );

    }

    return numero;

}


/* =========================================================
   CALENDÁRIO → GREGORIANO
========================================================= */

function obterDataGregoriana(
    ano,
    mes,
    dia
) {

    /*
       Calcula o número do dia dentro
       do calendário de 365/366 dias.

       Meses 1–13:
       27 dias cada.

       Mês 14:
       começa no dia 352.
    */

    let numeroDoDia = 0;


    /*
       Meses anteriores.
    */

    if (mes <= MESES_REGULARES) {

        numeroDoDia =
            (
                (mes - 1) *
                DIAS_POR_MES
            )
            +
            dia;

    }

    else {

        /*
           O mês 14 começa depois dos
           351 dias dos primeiros meses.
        */

        numeroDoDia =
            DIAS_REGULARES +
            dia;

    }


    /*
       Criar a data gregoriana.

       O Date usa:
       1º de janeiro como dia 1.

       Para chegar ao dia correto,
       usamos numeroDoDia - 1.
    */

    const data =
        new Date(
            ano,
            0,
            numeroDoDia
        );


    return data;

}


/* =========================================================
   FORMATAR DATA
========================================================= */

function formatarData(data) {

    return data.toLocaleDateString(
        "pt-BR",
        {
            weekday: "long",
            day: "2-digit",
            month: "2-digit",
            year: "numeric"
        }
    );

}


/* =========================================================
   VERIFICAR SE É HOJE
========================================================= */

function ehHoje(data) {

    const hoje = new Date();


    return (

        data.getFullYear() ===
        hoje.getFullYear()

        &&

        data.getMonth() ===
        hoje.getMonth()

        &&

        data.getDate() ===
        hoje.getDate()

    );

}


/* =========================================================
   CRIAR UM DIA
========================================================= */

function criarDia(
    ano,
    mes,
    dia
) {

    const elemento =
        document.createElement("div");


    elemento.classList.add(
        "day"
    );


    /*
       Número original.
    */

    const numero =
        document.createElement("div");


    numero.classList.add(
        "day-number"
    );


    /*
       Número original +
       número reduzido.
    */

    numero.innerHTML = `

        <span class="numero-original">
            ${dia}
        </span>

        <span class="numero-reduzido">
            ${reduzirNumero(dia)}
        </span>

    `;


    /*
       Data gregoriana.
    */

    const data =
        obterDataGregoriana(
            ano,
            mes,
            dia
        );


    const gregoriano =
        document.createElement("div");


    gregoriano.classList.add(
        "day-gregorian"
    );


    gregoriano.textContent =
        data.toLocaleDateString(
            "pt-BR"
        );


    /*
       Adicionar elementos.
    */

    elemento.appendChild(
        numero
    );


    elemento.appendChild(
        gregoriano
    );


    /*
       Verificar hoje.
    */

    if (ehHoje(data)) {

        elemento.classList.add(
            "today"
        );

    }


    /*
       Clique.
    */

    elemento.addEventListener(
        "click",
        function () {

            selecionarDia(

                ano,
                mes,
                dia,
                data,
                elemento

            );

        }
    );


    return elemento;

}


/* =========================================================
   POSICIONAR OS DIAS EM CÍRCULO
========================================================= */

function posicionarDiasCirculares() {

    const elementos =
        daysContainer.querySelectorAll(
            ".day"
        );


    const total =
        elementos.length;


    if (!total) {

        return;

    }


    /*
       Obtém o tamanho real do calendário.

       Isso permite que o círculo seja
       responsivo.
    */

    const largura =
        daysContainer.clientWidth;

    const altura =
        daysContainer.clientHeight;


    /*
       Raio do círculo.
    */

    const raio =
        Math.min(
            largura,
            altura
        ) * 0.40;


    elementos.forEach(
        function (
            elemento,
            indice
        ) {

            /*
               Divide os 360 graus igualmente
               entre os dias existentes.

               27 dias:
               360 / 27

               14 dias:
               360 / 14

               15 dias:
               360 / 15
            */

            const angulo =
                (indice / total)
                * Math.PI
                * 2
                - Math.PI / 2;


            /*
               Coordenada X.
            */

            const x =
                Math.cos(angulo)
                * raio;


            /*
               Coordenada Y.
            */

            const y =
                Math.sin(angulo)
                * raio;


            /*
               Posiciona o dia.
            */

            elemento.style.transform =
                `translate(${x}px, ${y}px)`;

        }
    );

}


/* =========================================================
   POSICIONAR OS DIAS DA SEMANA
========================================================= */

function posicionarDiasDaSemana() {

    const elementos =
        document.querySelectorAll(
            ".weekdays div"
        );


    const total =
        elementos.length;


    if (!total) {

        return;

    }


    /*
       O anel dos dias da semana fica
       mais próximo do centro.
    */

    const largura =
        daysContainer.clientWidth;

    const altura =
        daysContainer.clientHeight;


    const raio =
        Math.min(
            largura,
            altura
        ) * 0.25;


    elementos.forEach(
        function (
            elemento,
            indice
        ) {

            const angulo =
                (indice / total)
                * Math.PI
                * 2
                - Math.PI / 2;


            const x =
                Math.cos(angulo)
                * raio;


            const y =
                Math.sin(angulo)
                * raio;


            elemento.style.transform =
                `translate(-50%, -50%) translate(${x}px, ${y}px)`;

        }
    );

}


/* =========================================================
   POSICIONAR CALENDÁRIO CIRCULAR
========================================================= */

function posicionarCalendarioCircular() {

    posicionarDiasCirculares();

    posicionarDiasDaSemana();

}


/* =========================================================
   REDIMENSIONAMENTO
========================================================= */

window.addEventListener(
    "resize",
    function () {

        posicionarCalendarioCircular();

    }
);


/* =========================================================
   RENDERIZAR OS DIAS DO MÊS
========================================================= */

function renderizarDias() {

    /*
       Limpar calendário.
    */

    daysContainer.innerHTML = "";


    /*
       Descobrir quantos dias possui
       o mês atual.
    */

    const quantidadeDias =
        quantidadeDiasMes(
            mesAtual,
            anoAtual
        );


    /*
       Criar os dias.
    */

    for (

        let dia = 1;

        dia <= quantidadeDias;

        dia++

    ) {

        const elemento =
            criarDia(

                anoAtual,
                mesAtual,
                dia

            );


        daysContainer.appendChild(
            elemento
        );

    }


    /*
       Esperar o navegador calcular
       o tamanho do calendário.
    */

    requestAnimationFrame(
        function () {

            posicionarCalendarioCircular();

        }
    );

}


/* =========================================================
   RENDERIZAR CALENDÁRIO COMPLETO
========================================================= */

function renderizarCalendario() {

    /*
       Título.
    */

    monthName.textContent =
        nomesMeses[
            mesAtual - 1
        ];


    yearDisplay.textContent =
        anoAtual;


    /*
       Atualizar o centro.
    */

    if (centerMonth) {

        centerMonth.textContent =
            nomesMeses[
                mesAtual - 1
            ];

    }


    if (centerYear) {

        centerYear.textContent =
            anoAtual;

    }


    /*
       Dias.
    */

    renderizarDias();


    /*
       Não precisamos mais de
       "Dias Extras" separados.

       O antigo campo é mantido
       vazio para não quebrar o HTML.
    */

    renderizarDiasExtras();

}


/* =========================================================
   SELECIONAR DIA
========================================================= */

function selecionarDia(
    ano,
    mes,
    dia,
    data,
    elemento
) {

    /*
       Remover seleção anterior.
    */

    document
        .querySelectorAll(".day")
        .forEach(

            function (diaElemento) {

                diaElemento.classList.remove(
                    "selected"
                );

            }

        );


    /*
       Marcar selecionado.
    */

    elemento.classList.add(
        "selected"
    );


    /*
       Número reduzido.
    */

    const numeroReduzido =
        reduzirNumero(dia);


    /*
       Mostrar informações.
    */

    selectedDate.textContent =

        `${nomesMeses[mes - 1]} — Dia ${dia} → ${numeroReduzido}`;


    /*
       Data gregoriana.
    */

    gregorianDate.textContent =

        `Data gregoriana: ${formatarData(data)}`;


    /*
       Número do dia no ano.
    */

    const numeroDoDia =
        obterNumeroDoDia(
            mes,
            dia
        );


    dayOfYear.textContent =

        `Dia ${numeroDoDia} de ${quantidadeDiasNoAno(ano)}`;

}


/* =========================================================
   OBTER NÚMERO DO DIA NO ANO
========================================================= */

function obterNumeroDoDia(
    mes,
    dia
) {

    /*
       Meses 1–13.
    */

    if (mes <= MESES_REGULARES) {

        return (

            (mes - 1) *
            DIAS_POR_MES

        ) + dia;

    }


    /*
       Mês 14.
    */

    return (

        DIAS_REGULARES +
        dia

    );

}


/* =========================================================
   DIAS EXTRAS
========================================================= */

function renderizarDiasExtras() {

    /*
       O sistema antigo possuía uma área
       separada para Dias Extras.

       Agora os dias 365/366 pertencem
       ao 14º mês.

       Portanto deixamos essa área vazia.
    */

    if (!extraDays) {

        return;

    }


    extraDays.innerHTML = "";

}


/* =========================================================
   MUDAR MÊS
========================================================= */

function mudarMes(valor) {

    mesAtual += valor;


    /*
       Passou do mês 14.
    */

    if (mesAtual > TOTAL_MESES) {

        mesAtual = 1;

        anoAtual++;

    }


    /*
       Voltou antes do mês 1.
    */

    if (mesAtual < 1) {

        mesAtual = TOTAL_MESES;

        anoAtual--;

    }


    renderizarCalendario();

}


/* =========================================================
   MUDAR ANO
========================================================= */

function mudarAno(valor) {

    anoAtual += valor;

    renderizarCalendario();

}


/* =========================================================
   IR PARA HOJE
========================================================= */

function irParaHoje() {

    const hoje = new Date();


    /*
       Ano atual.
    */

    anoAtual =
        hoje.getFullYear();


    /*
       Número do dia gregoriano
       dentro do ano.
    */

    const inicioDoAno =
        new Date(

            anoAtual,
            0,
            1

        );


    const diferenca =
        Math.floor(

            (
                hoje -
                inicioDoAno
            )

            /

            (
                1000 *
                60 *
                60 *
                24
            )

        );


    /*
       Número do dia do ano.

       1 = 1º de janeiro
    */

    const numeroDoDia =
        diferenca + 1;


    /*
       Descobrir o mês do calendário.
    */

    if (
        numeroDoDia <=
        DIAS_REGULARES
    ) {

        /*
           Meses 1–13.

           Cada um possui 27 dias.
        */

        mesAtual =

            Math.floor(

                (
                    numeroDoDia - 1
                )

                /

                DIAS_POR_MES

            )

            + 1;

    }

    else {

        /*
           Dias 352 em diante
           pertencem ao mês 14.
        */

        mesAtual = TOTAL_MESES;

    }


    /*
       Renderizar.
    */

    renderizarCalendario();


    /*
       Selecionar o dia atual.
    */

    let dia;


    if (
        numeroDoDia <=
        DIAS_REGULARES
    ) {

        /*
           Dia dentro dos meses 1–13.
        */

        dia =

            (
                (
                    numeroDoDia - 1
                )

                %

                DIAS_POR_MES

            )

            + 1;

    }

    else {

        /*
           Dia dentro do mês 14.

           352 → dia 1
           353 → dia 2
           ...
           365 → dia 14
           366 → dia 15
        */

        dia =
            numeroDoDia -
            DIAS_REGULARES;

    }


    /*
       Localizar elemento.
    */

    const elementos =
        document.querySelectorAll(
            ".day"
        );


    /*
       O índice começa em zero.
    */

    const indice =
        dia - 1;


    if (elementos[indice]) {

        const data =
            obterDataGregoriana(

                anoAtual,
                mesAtual,
                dia

            );


        selecionarDia(

            anoAtual,
            mesAtual,
            dia,
            data,
            elementos[indice]

        );

    }

}


